# Kafka connection. Local Docker Kafka uses localhost:29092 from the host.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISMS=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CA_LOCATION=
KAFKA_TOPIC=demo-events
# Left blank: each consumer generates its own <client_id>-<8 random hex chars> group so
# unrelated runs against a shared broker don't collide. Set this to resume the same
# group (and its committed offsets) across restarts instead.
KAFKA_GROUP_ID=
KAFKA_CLIENT_ID=python-monitoring-example

# Application behavior
DEPLOYMENT_ENVIRONMENT=dev
KAFKA_STATS_INTERVAL_MS=30000
PRODUCER_MESSAGES=100
PRODUCER_INTERVAL_MS=100
PROCESSING_MS=10

# Application -> local OpenTelemetry Collector (default).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=python-kafka-app

# Collector -> New Relic. Set these in the shell or an environment manager, not
# committed to source control.
NEW_RELIC_LICENSE_KEY=replace-me
NEW_RELIC_OTLP_ENDPOINT=https://otlp.eu01.nr-data.net

# To skip the Collector and send OTLP straight to New Relic instead (see README
# "Alternative: direct to New Relic"), point this at New Relic's own OTLP host:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.eu01.nr-data.net

# NerdGraph API (dashboard deploy only, see README "New Relic dashboard"). A User API key
# (starts with NRAK-...), not the ingest license key above, plus your account ID. 123456789
# is the same placeholder baked into newrelic-dashboard.json's widgets — replace both with
# your real account ID (the curl command in the README falls back to it if left unset).
NEW_RELIC_API_KEY=replace-me
NEW_RELIC_ACCOUNT_ID=123456789
