# Kafka connection. Local Docker Kafka uses localhost:29092 from the host.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISMS=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CA_LOCATION=
KAFKA_TOPIC=demo-events
# Left blank: each consumer generates its own <client_id>-<8 random hex chars> group so
# unrelated runs against a shared broker don't collide. Set this to resume the same
# group (and its committed offsets) across restarts instead.
KAFKA_GROUP_ID=
KAFKA_CLIENT_ID=python-monitoring-example

# Application behavior
DEPLOYMENT_ENVIRONMENT=dev
KAFKA_STATS_INTERVAL_MS=30000
PRODUCER_MESSAGES=100
PRODUCER_INTERVAL_MS=100
PROCESSING_MS=10

# Application -> local OpenTelemetry Collector (default).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=python-kafka-app

# Collector -> New Relic. Set these in the shell or an environment manager, not
# committed to source control.
NEW_RELIC_LICENSE_KEY=replace-me
NEW_RELIC_OTLP_ENDPOINT=https://otlp.eu01.nr-data.net

# To skip the Collector and send OTLP straight to New Relic instead (see README
# "Alternative: direct to New Relic"), point this at New Relic's own OTLP host:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.eu01.nr-data.net

# NerdGraph API (dashboard deploy only, see README "New Relic dashboard"). A User API key
# (starts with NRAK-...), not the ingest license key above, plus your account ID. 123456789
# is the same placeholder baked into newrelic-dashboard.json's widgets — replace both with
# your real account ID (the curl command in the README falls back to it if left unset).
NEW_RELIC_API_KEY=replace-me
NEW_RELIC_ACCOUNT_ID=123456789
# Optional: assign deployed dashboards to a New Relic team (the nr.team tag will
# appear on the entity automatically). Set to the exact team name as shown in the
# New Relic Teams UI. Quote the value if it contains spaces. Leave blank or unset to skip.
# NEW_RELIC_TEAM_NAME="My Team"

# ── Confluent Cloud (used by start-infra-ccloud.sh) ──────────────────────────
# Confluent Cloud API key/secret with the MetricsViewer role — used by the OTel
# Collector to scrape the Confluent Metrics API (api.telemetry.confluent.cloud).
# Create a service account, assign it the MetricsViewer role, and generate an
# API key scoped to "Cloud resource management".
CONFLUENT_API_KEY=replace-me
CONFLUENT_API_SECRET=replace-me

# Confluent Cloud Kafka cluster ID — a single ID or a comma-separated list for
# multi-cluster monitoring (e.g. lkc-abc123,lkc-def456). Find cluster IDs in the
# Confluent Cloud UI under Cluster Settings, or via: confluent kafka cluster list
# start-infra-ccloud.sh expands this into the OTel collector config at startup.
CONFLUENT_CLUSTER_ID=lkc-replace-me

# Optional: uncomment and set to also scrape Schema Registry / Connector metrics.
# Uncomment the matching params blocks in collector/otel-collector-ccloud.yaml too.
# CONFLUENT_SCHEMA_REGISTRY_ID=lsrc-replace-me
# CONFLUENT_CONNECTOR_ID=lcc-replace-me

# ── Confluent Cloud audit & connector logs ────────────────────────────────────
# The audit log cluster is separate from the main Kafka cluster and has its own
# bootstrap endpoint and credentials. These three vars are shared by both the
# audit log pipeline (confluent-audit-log-events) and the managed connector log
# pipeline (confluent-connect-log-events) in collector/otel-collector-ccloud.yaml.
# Find bootstrap in the Confluent Cloud UI under "Audit log cluster", or via:
#   confluent audit-log describe
# Create a service account with the OrganizationAdmin or AuditLogViewer role.
CONFLUENT_AUDIT_BOOTSTRAP_SERVERS=pkac-replace-me.region.provider.confluent.cloud:9092
CONFLUENT_AUDIT_SASL_USERNAME=replace-me
CONFLUENT_AUDIT_SASL_PASSWORD=replace-me

# ── Confluent Platform JMX (used by start-infra-cp.sh) ───────────────────────
# No extra env vars are required beyond NEW_RELIC_LICENSE_KEY above.
# The jmx_prometheus_javaagent is attached to the Kafka broker container via
# docker-compose.cp-jmx.yml and nri-prometheus scrapes it at port 1234,
# forwarding metrics directly to New Relic using NEW_RELIC_LICENSE_KEY.
# JMX exporter rules: jmx-exporter/kafka_broker.yml (sourced from
# confluentinc/jmx-monitoring-stacks shared-assets).