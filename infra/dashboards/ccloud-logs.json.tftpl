{
  "name": "Confluent Cloud Logs",
  "permissions": "PUBLIC_READ_ONLY",
  "description": null,
  "pages": [
    {
      "name": "Audit Logs",
      "description": null,
      "widgets": [
        {
          "title": "Failed Operations",
          "description": "Kafka/API operations that were authorised but failed at execution (data.result.status = 'FAILURE'). Examples: topic already exists, quota exceeded, invalid config. The principal had permission — the operation itself errored.",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 3,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "SELECT count(*) AS 'Failed Operations' FROM Log WHERE confluent.log.source = 'confluent-audit' AND data.result.status = 'FAILURE' AND (crn.environment = {{crn_environment}} OR {{crn_environment}} = 'all') AND (crn.cloud_cluster = {{crn_cluster}} OR {{crn_cluster}} = 'all') AND (crn.schema_registry = {{crn_schema_registry}} OR {{crn_schema_registry}} = 'all')"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "thresholds": [
              {
                "alertSeverity": "CRITICAL",
                "value": 0
              }
            ]
          }
        },
        {
          "title": "Schema Registry Authorizations Denied",
          "description": "Schema Registry-specific RBAC rejection (sg.server/authorization). The SR evaluated the principal's role binding (e.g. SchemaRegistryDeveloperRead) against the requested subject/schema resource and denied it. Only fires for SR API calls — not Kafka broker operations. Field: data.authorizationInfo.result = 'DENY'.",
          "layout": {
            "column": 4,
            "row": 1,
            "width": 3,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "SELECT count(*) AS 'SR Authz Denied' FROM Log WHERE confluent.log.source = 'confluent-audit' AND data.authorizationInfo.result = 'DENY' AND (crn.environment = {{crn_environment}} OR {{crn_environment}} = 'all') AND (crn.cloud_cluster = {{crn_cluster}} OR {{crn_cluster}} = 'all') AND (crn.schema_registry = {{crn_schema_registry}} OR {{crn_schema_registry}} = 'all')"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "thresholds": [
              {
                "alertSeverity": "CRITICAL",
                "value": 0
              }
            ]
          }
        },
        {
          "title": "RBAC Denied",
          "description": "Confluent RBAC rejection via the MDS (Metadata Service) broker-side check (kafka.server/authorization, method mds.Authorize). Covers all Kafka protocol operations — topics, connectors, compute pools, schema registry clusters. Fired before the broker executes the request; the principal has no role binding covering this resource and operation. Field: data.authorizationInfo.granted = 'false'.",
          "layout": {
            "column": 7,
            "row": 1,
            "width": 3,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "SELECT count(*) AS 'RBAC Denied' FROM Log WHERE confluent.log.source = 'confluent-audit' AND data.authorizationInfo.granted = 'false' AND (crn.environment = {{crn_environment}} OR {{crn_environment}} = 'all') AND (crn.cloud_cluster = {{crn_cluster}} OR {{crn_cluster}} = 'all') AND (crn.schema_registry = {{crn_schema_registry}} OR {{crn_schema_registry}} = 'all')"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "thresholds": [
              {
                "alertSeverity": "CRITICAL",
                "value": 0
              }
            ]
          }
        },
        {
          "title": "Failed Authentications",
          "description": "Failed authentications: (1) data.result.status = 'UNAUTHENTICATED' (unknown/invalid API key or secret, principal None:UNKNOWN_USER), and (2) soft-rejections where the token was recognised but invalid (e.g. JWT_EXPIRED): Confluent records result = 'SUCCESS' but sets data.authenticationInfo.errorMessage with the real reason. Common cause of (2): client not refreshing OAuth token before expiry.",
          "layout": {
            "column": 10,
            "row": 1,
            "width": 3,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "SELECT count(*) AS 'Failed Auths' FROM Log WHERE confluent.log.source = 'confluent-audit' AND (data.result.status = 'UNAUTHENTICATED' OR data.authenticationInfo.errorMessage IS NOT NULL) AND (crn.environment = {{crn_environment}} OR {{crn_environment}} = 'all') AND (crn.cloud_cluster = {{crn_cluster}} OR {{crn_cluster}} = 'all') AND (crn.schema_registry = {{crn_schema_registry}} OR {{crn_schema_registry}} = 'all')"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "thresholds": [
              {
                "alertSeverity": "CRITICAL",
                "value": 0
              }
            ]
          }
        },
        {
          "title": "Denial Types Over Time",
          "layout": {
            "column": 1,
            "row": 4,
            "width": 12,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "SELECT count(*) FROM Log WHERE confluent.log.source = 'confluent-audit' AND (data.authorizationInfo.result = 'DENY' OR data.authorizationInfo.granted = 'false' OR data.result.status = 'UNAUTHENTICATED' OR data.authenticationInfo.errorMessage IS NOT NULL) AND (crn.environment = {{crn_environment}} OR {{crn_environment}} = 'all') AND (crn.cloud_cluster = {{crn_cluster}} OR {{crn_cluster}} = 'all') AND (crn.schema_registry = {{crn_schema_registry}} OR {{crn_schema_registry}} = 'all') TIMESERIES AUTO FACET cases(WHERE data.authorizationInfo.result = 'DENY' AS 'AuthZ DENY', WHERE data.authorizationInfo.granted = 'false' AS 'RBAC Denied', WHERE data.result.status = 'UNAUTHENTICATED' AS 'Unauthenticated', WHERE data.authenticationInfo.errorMessage IS NOT NULL AS 'Token Error') LIMIT 4"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "yAxisLeft": {
              "zero": true
            }
          }
        },
        {
          "title": "Event Count Over Time",
          "layout": {
            "column": 1,
            "row": 7,
            "width": 12,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "SELECT count(*) FROM Log WHERE confluent.log.source = 'confluent-audit' AND (data.result.status = {{result_status}} OR {{result_status}} = 'all') AND (crn.environment = {{crn_environment}} OR {{crn_environment}} = 'all') AND (crn.cloud_cluster = {{crn_cluster}} OR {{crn_cluster}} = 'all') AND (crn.schema_registry = {{crn_schema_registry}} OR {{crn_schema_registry}} = 'all') TIMESERIES AUTO FACET type LIMIT 20"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "yAxisLeft": {
              "zero": true
            }
          }
        },
        {
          "title": "Raw Audit Log Events",
          "layout": {
            "column": 1,
            "row": 10,
            "width": 12,
            "height": 8
          },
          "visualization": {
            "id": "logger.log-table-widget"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "SELECT timestamp, type, `data.methodName`, `data.result.status`, `data.result.data.errorType`, `data.result.data.message`, `data.authenticationInfo.principal`, `data.authenticationInfo.errorMessage`, `data.authorizationInfo.granted`, `data.authorizationInfo.result`, `data.authorizationInfo.operation`, `data.authorizationInfo.resourceType`, source FROM Log WHERE confluent.log.source = 'confluent-audit' AND (data.result.status = {{result_status}} OR {{result_status}} = 'all') AND (crn.environment = {{crn_environment}} OR {{crn_environment}} = 'all') AND (crn.cloud_cluster = {{crn_cluster}} OR {{crn_cluster}} = 'all') AND (crn.schema_registry = {{crn_schema_registry}} OR {{crn_schema_registry}} = 'all') LIMIT 100"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        }
      ]
    },
    {
      "name": "Connector Logs",
      "description": null,
      "widgets": [
        {
          "title": "Failed Tasks Over Time",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 12,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "SELECT count(*) FROM Log WHERE confluent.log.source = 'confluent-connector' AND (crn.environment = {{crn_environment}} OR {{crn_environment}} = 'all') AND (crn.connector = {{crn_connector}} OR {{crn_connector}} = 'all') TIMESERIES AUTO FACET `data.context.connectorId` LIMIT 10"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "yAxisLeft": {
              "zero": true
            }
          }
        },
        {
          "title": "Raw Connector Log Events",
          "layout": {
            "column": 1,
            "row": 4,
            "width": 12,
            "height": 8
          },
          "visualization": {
            "id": "logger.log-table-widget"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "SELECT timestamp, `data.context.connectorId`, `data.summary.connectorErrorSummary.message`, `data.summary.connectorErrorSummary.rootCause`, source FROM Log WHERE confluent.log.source = 'confluent-connector' AND (crn.environment = {{crn_environment}} OR {{crn_environment}} = 'all') AND (crn.connector = {{crn_connector}} OR {{crn_connector}} = 'all') LIMIT 100"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        }
      ]
    }
  ],
  "variables": [
    {
      "name": "result_status",
      "items": null,
      "defaultValues": [
        {
          "value": {
            "string": "all"
          }
        }
      ],
      "nrqlQuery": {
        "accountIds": [${account_id}],
        "query": "SELECT uniques(data.result.status) FROM Log WHERE confluent.log.source = 'confluent-audit' SINCE 1 week ago"
      },
      "options": {
        "ignoreTimeRange": true
      },
      "title": "Result Status",
      "type": "NRQL",
      "isMultiSelection": false,
      "replacementStrategy": "STRING"
    },
    {
      "name": "crn_environment",
      "items": null,
      "defaultValues": [
        {
          "value": {
            "string": "all"
          }
        }
      ],
      "nrqlQuery": {
        "accountIds": [${account_id}],
        "query": "SELECT uniques(crn.environment) FROM Log WHERE confluent.log.source IN ('confluent-audit', 'confluent-connector') SINCE 1 week ago"
      },
      "options": {
        "ignoreTimeRange": true
      },
      "title": "Environment",
      "type": "NRQL",
      "isMultiSelection": false,
      "replacementStrategy": "STRING"
    },
    {
      "name": "crn_cluster",
      "items": null,
      "defaultValues": [
        {
          "value": {
            "string": "all"
          }
        }
      ],
      "nrqlQuery": {
        "accountIds": [${account_id}],
        "query": "SELECT uniques(crn.cloud_cluster) FROM Log WHERE confluent.log.source = 'confluent-audit' SINCE 1 week ago"
      },
      "options": {
        "ignoreTimeRange": true
      },
      "title": "Kafka Cluster",
      "type": "NRQL",
      "isMultiSelection": false,
      "replacementStrategy": "STRING"
    },
    {
      "name": "crn_schema_registry",
      "items": null,
      "defaultValues": [
        {
          "value": {
            "string": "all"
          }
        }
      ],
      "nrqlQuery": {
        "accountIds": [${account_id}],
        "query": "SELECT uniques(crn.schema_registry) FROM Log WHERE confluent.log.source = 'confluent-audit' SINCE 1 week ago"
      },
      "options": {
        "ignoreTimeRange": true
      },
      "title": "Schema Registry",
      "type": "NRQL",
      "isMultiSelection": false,
      "replacementStrategy": "STRING"
    },
    {
      "name": "crn_connector",
      "items": null,
      "defaultValues": [
        {
          "value": {
            "string": "all"
          }
        }
      ],
      "nrqlQuery": {
        "accountIds": [${account_id}],
        "query": "SELECT uniques(crn.connector) FROM Log WHERE confluent.log.source = 'confluent-connector' SINCE 1 week ago"
      },
      "options": {
        "ignoreTimeRange": true
      },
      "title": "Connector",
      "type": "NRQL",
      "isMultiSelection": false,
      "replacementStrategy": "STRING"
    }
  ]
}
